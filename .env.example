PORT=3000
# Set TRUST_PROXY=true only when hosted behind a trusted reverse proxy.
TRUST_PROXY=false
# Keep database in a persistent directory outside public assets.
DB_PATH=./data/leads.sqlite
TO_EMAIL=leads@yourdomain.com
FROM="Prime Union Trucking <hello@yourdomain.com>"
SIGNOFF="Your Name, Prime Union Trucking"
# Email is optional for local testing; leads are still stored without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Generate a long random secret. Only authorized managers should get it.
ADMIN_KEY=

# Booking calendar — REQUIRED on Vercel for working bookings.
# Create a Neon Postgres database and set DATABASE_URL in Vercel project environment.
DATABASE_URL=
# Only publish real staff-confirmed Eastern Time appointment windows.
# Day values: 0=Sunday, 1=Monday, ..., 6=Saturday
BOOKING_DAYS=
# 24-hour Eastern Time separated by commas, e.g. 17:00,17:30,18:00
BOOKING_TIMES=
